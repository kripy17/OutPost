# airgap-ci — full-stack test image for the OFFLINE air-gap verification.
#
# Everything the four-gate bundle + the e2e gates need is installed at BUILD
# time (network available during docker build). At RUNTIME the container is
# launched with `--network none`, so only loopback exists: any attempt to
# reach an external host fails at the OS level, regardless of library or
# technique. This is the strongest air-gap proof in CI — the in-process
# probes simulate blocking, this makes it real.
#
# Base: Debian bookworm with Node 22 (frontend) + Python 3.11 (backend).
FROM node:22-bookworm-slim

WORKDIR /src

# Python for the backend/CLI (bookworm ships 3.11; the project requires >=3.10).
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip git \
    && rm -rf /var/lib/apt/lists/*

# Backend + CLI into a project venv.
COPY . .
RUN python3 -m venv .venv \
    && .venv/bin/pip install --upgrade pip \
    && .venv/bin/pip install -e "./backend[dev]" -e ./cli

# Frontend: deps + the production build (the artifact gate scans it).
# VITE_API_URL is baked explicitly (env beats .env.local): the browser must
# reach the loopback backend over IPv4 — localhost can resolve to ::1 while
# uvicorn binds 127.0.0.1, which silently breaks every API call.
RUN cd frontend && VITE_API_URL=http://127.0.0.1:8001 npm ci \
    && VITE_API_URL=http://127.0.0.1:8001 npm run build

# Demo: Playwright + Chromium (browsers + system deps land in the image).
RUN cd demo && npm ci && npx playwright install --with-deps chromium

# Default: run the offline verification (boots backend+preview on loopback,
# seeds, runs the four-gate bundle + both e2es, exits non-zero on failure).
CMD ["bash", "scripts/airgap-offline.sh"]
