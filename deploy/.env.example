# OutPost production env — copy to .env.prod and fill in.
#   cp deploy/.env.example .env.prod && $EDITOR .env.prod

# Public hostname. Must resolve to this server for Let's Encrypt auto-TLS;
# for a no-domain test box use `tls internal` in deploy/Caddyfile and set
# this to the server's IP/hostname.
OUTPOST_HOST=outpost.example.com

# REQUIRED — auth is on by default and the backend refuses to start without
# an admin credential. Use a long random value, or a precomputed
# OUTPOST_ADMIN_PASSWORD_HASH (from `outpost auth hash`) instead of the
# plaintext. Example: openssl rand -hex 24
OUTPOST_ADMIN_PASSWORD=change-me

# Optional read-only analyst role.
OUTPOST_ANALYST_PASSWORD=

# Optional auth rate-limit knobs (defaults shown).
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=300
AUTH_LOCKOUT_SECONDS=900
